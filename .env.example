# Copy to .env and fill in values.
# NEVER put secret keys in Angular environment*.ts or commit them.
#
# Used by: scripts/register-api.cjs (local) and api/register.js (Vercel)
# Angular EmailJS + Supabase anon key live in src/environments/*.ts

SUPABASE_URL=https://udvyynbpzbhdmgwbkjkd.supabase.co
# Same publishable key as src/environments/environment.ts (browser-safe)
SUPABASE_ANON_KEY=sb_publishable_UpuN_SDJoPuOPJha_WlW3Q_ncn6vZ06
# REQUIRED only for local /api/register admin.createUser (staff/admin create).
# Public OTP registration falls back to browser Auth signup if this is missing.
# Paste real secret from Dashboard → Project Settings → API Keys (never commit).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Optional local registration helper port (default 3001)
REGISTER_API_PORT=3001

SUPABASE_EMAIL_REDIRECT_TO=http://localhost:4200/login
SUPABASE_SITE_URL=http://localhost:4200

# EmailJS is configured in src/environments/environment.ts (browser public key only).
# Private key stays in EmailJS dashboard — never commit it.
# These .env keys are documentation only — the Node register API does not read them.
EMAILJS_PUBLIC_KEY=bjJ7RRPqSEP0aYrNn
EMAILJS_SERVICE_ID=service_0g0kojl
EMAILJS_OTP_TEMPLATE_ID=template_gs077yl
EMAILJS_LOGIN_URL=http://localhost:4200/login
